{
  "name": "@cockroachdb/prisma",
  "version": "0.2.0",
  "description": "Prisma adapter for CockroachDB: transaction retries on serialization conflicts (40001 / P2034).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "publishConfig": { "registry": "https://cockroachlabs.github.io/cockroachdb-typescript-library/" },
  "scripts": { "build": "tsc -b" },
  "dependencies": {
    "@cockroachdb/core": "^0.2.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=6"
  },
  "peerDependenciesMeta": {
    "@prisma/client": { "optional": true }
  }
}
