{
  "name": "@cockroachdb/pg",
  "version": "0.1.0",
  "description": "node-postgres adapter for CockroachDB: transaction retries on 40001, follower reads, @transactional decorator, metrics, health.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "registry": "https://cockroachlabs.github.io/cockroachdb-typescript-library/"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@cockroachdb/core": "^0.1.0",
    "pg": "^8.13"
  },
  "devDependencies": {
    "@types/pg": "^8.11"
  }
}
