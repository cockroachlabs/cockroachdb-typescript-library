{
  "name": "@cockroachdb/drizzle",
  "version": "0.2.2",
  "description": "Drizzle ORM adapter for CockroachDB: transaction retries on serialization conflicts (40001).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://cockroachlabs.github.io/cockroachdb-typescript-library/"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@cockroachdb/core": "^0.2.0"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  }
}
